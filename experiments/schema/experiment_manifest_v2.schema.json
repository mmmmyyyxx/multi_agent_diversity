{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified experiment manifest v2",
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "method_identity": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "search_engine_identity": {
      "type": "string",
      "minLength": 1
    },
    "aggregation_identity": {
      "type": "string",
      "minLength": 1
    },
    "responsibility_identity": {
      "type": "string",
      "minLength": 1
    },
    "transition_identity": {
      "type": "string",
      "minLength": 1
    },
    "adaptive_gate_identity": {
      "type": "string",
      "minLength": 1
    },
    "pattern_identity": {
      "type": "string",
      "minLength": 1
    },
    "memory_identity": {
      "type": "string",
      "minLength": 1
    },
    "global_stop_identity": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "experiment_manifest_v2"
    },
    "method_family": {
      "enum": [
        "unified_team_prompt_search_v1",
        "unified_team_prompt_search_v2",
        "unified_team_prompt_search_v2_1"
      ]
    },
    "source_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "dataset_manifest_identity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "split_identity": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "preregistration_identity": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "models": {
      "type": "object",
      "properties": {
        "solver": {
          "type": [
            "string",
            "null"
          ]
        },
        "optimizer": {
          "type": [
            "string",
            "null"
          ]
        },
        "solver_thinking": {
          "type": "boolean"
        }
      },
      "required": [
        "solver",
        "optimizer",
        "solver_thinking"
      ],
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "solver": {
          "type": "integer",
          "minimum": 1
        },
        "optimizer": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "solver",
        "optimizer"
      ],
      "additionalProperties": false
    },
    "provider_policy": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "frozen"
      ],
      "additionalProperties": false
    },
    "cache_policy": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "frozen"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "search_access": {
          "type": "string",
          "enum": [
            "not_authorized",
            "frozen_search",
            "frozen_adaptive_gate",
            "separately_authorized_post_freeze"
          ]
        },
        "shadow_access": {
          "type": "string",
          "enum": [
            "not_authorized",
            "frozen_search",
            "frozen_adaptive_gate",
            "separately_authorized_post_freeze"
          ]
        },
        "validation_access": {
          "type": "string",
          "enum": [
            "not_authorized",
            "frozen_search",
            "frozen_adaptive_gate",
            "separately_authorized_post_freeze"
          ]
        },
        "test_access": {
          "type": "string",
          "enum": [
            "sealed",
            "separately_authorized_post_freeze"
          ]
        }
      },
      "required": [
        "search_access",
        "shadow_access",
        "validation_access",
        "test_access"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "regime": {
          "enum": [
            "saturation",
            "fixed_budget"
          ]
        },
        "saturation_identity": {
          "type": "string",
          "minLength": 1
        },
        "successful_provider_call_ceiling": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "transport_attempt_ceiling": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "regime",
        "saturation_identity",
        "successful_provider_call_ceiling",
        "transport_attempt_ceiling"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "real_api_authorized": {
          "type": "boolean",
          "default": false
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorization_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "single_use": {
          "const": true
        }
      },
      "required": [
        "real_api_authorized",
        "attempt_id",
        "authorization_identity",
        "single_use"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "PREREGISTERED",
            "FROZEN",
            "RUNNING",
            "COMPLETED",
            "ABORTED",
            "PREEXECUTION_FROZEN"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "status",
        "history"
      ],
      "additionalProperties": false
    },
    "hash_closure": {
      "type": "object",
      "properties": {
        "scientific_source_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "governance_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "benchmark_contract_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataset_manifest_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "scientific_source_hash",
        "governance_hash",
        "benchmark_contract_hash",
        "dataset_manifest_hash"
      ],
      "additionalProperties": false
    },
    "search_acceptance_identity": {
      "type": "string",
      "minLength": 1
    },
    "evidence_identity": {
      "type": "string",
      "minLength": 1
    },
    "feasibility_identity": {
      "type": "string",
      "minLength": 1
    },
    "mechanism_config": {
      "type": "object"
    },
    "solver_output_interface_identity": {
      "type": "string",
      "minLength": 1
    },
    "parser_identity": {
      "type": "string",
      "minLength": 1
    },
    "execution_binding": {
      "type": "object",
      "properties": {
        "identity": {
          "enum": [
            "MATH_EXECUTION_BINDING_V1",
            "MATH_EXECUTION_BINDING_V1_2",
            "MATH_EXECUTION_BINDING_V1_3",
            "MATH_EXECUTION_BINDING_V1_4",
            "MATH_V2_1_EXECUTION_BINDING_V1",
            "MATH_V2_1_EXECUTION_BINDING_V2",
            "MATH_V2_1_EXECUTION_BINDING_V3",
            "MATH_V2_1_LOW_COST_EXECUTION_BINDING_V1",
            "MATH_V2_1_LOW_COST_EXECUTION_BINDING_V2"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "identity",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "initial_competence_binding": {
      "type": "object",
      "properties": {
        "identity": {
          "enum": [
            "MATH_INITIAL_COMPETENCE_OPTIMIZE_V2_1",
            "MATH_INITIAL_COMPETENCE_LOW_COST_V1"
          ]
        },
        "role": {
          "const": "optimize"
        },
        "count": {
          "enum": [
            12,
            60,
            150
          ]
        },
        "metric": {
          "const": "binary_correct_count"
        },
        "evaluator": {
          "const": "MATH_EQUIVALENCE_V2"
        },
        "aggregation_independent": {
          "const": true
        },
        "split_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "support_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_support": {
          "const": "same_complete_optimize"
        },
        "immutable": {
          "const": true
        }
      },
      "required": [
        "identity",
        "role",
        "count",
        "metric",
        "evaluator",
        "aggregation_independent",
        "split_identity",
        "support_identity",
        "candidate_support",
        "immutable"
      ],
      "additionalProperties": false
    },
    "solver_decoding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "enable_thinking",
        "temperature",
        "top_p",
        "top_k",
        "min_p",
        "presence_penalty",
        "frequency_penalty",
        "max_output_tokens"
      ],
      "properties": {
        "identity": {
          "const": "SOLVER_DECODING_POLICY_V1",
          "type": "string"
        },
        "enable_thinking": {
          "const": false,
          "type": "boolean"
        },
        "temperature": {
          "const": 0.7,
          "type": "number"
        },
        "top_p": {
          "const": 0.8,
          "type": "number"
        },
        "top_k": {
          "const": 20,
          "type": "integer"
        },
        "min_p": {
          "const": 0,
          "type": "integer"
        },
        "presence_penalty": {
          "const": 0,
          "type": "integer"
        },
        "frequency_penalty": {
          "const": 0,
          "type": "integer"
        },
        "max_output_tokens": {
          "const": 3600,
          "type": "integer"
        }
      }
    },
    "prediction_validity_policy": {
      "anyOf": [
        {
          "const": {
            "identity": "MATH_PREDICTION_VALIDITY_V1",
            "reference_failure": "hard_contract_failure",
            "prediction_failure": "invalid_incorrect_continue",
            "truncated_even_with_marker": "invalid_incorrect",
            "invalid_response_retries": 0,
            "fallback_extraction": false,
            "invalid_vote": "excluded_from_equivalence_classes",
            "denominator": "all_frozen_examples",
            "invalidity_telemetry": "observation_only"
          }
        },
        {
          "const": {
            "identity": "MATH_PREDICTION_VALIDITY_V2",
            "reference_failure": "hard_contract_failure",
            "prediction_failure": "invalid_incorrect_continue",
            "truncated_even_with_marker": "invalid_incorrect",
            "invalid_response_retries": 3,
            "fallback_extraction": false,
            "invalid_vote": "excluded_from_equivalence_classes",
            "denominator": "all_frozen_examples",
            "invalidity_telemetry": "observation_only"
          }
        }
      ]
    },
    "invalid_recovery_policy": {
      "const": {
        "identity": "MATH_SOLVER_INVALID_RECOVERY_V1",
        "solver_invalid_max_retries": 3,
        "max_semantic_attempts": 4,
        "same_request_bytes": true,
        "first_valid_stops": true,
        "transport_failures_consume_semantic_attempt": false,
        "terminal_requires_completed_invalid_attempts": 4,
        "terminal_invalid": "incorrect_continue_no_vote",
        "logical_evaluation_count": 1,
        "cache": "resolved_valid_or_exhausted_terminal_only",
        "invalidity_weight": "none"
      }
    },
    "low_cost_protocol": {
      "type": "object"
    },
    "low_cost_subsets_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "optimizer_generation_policy": {
      "anyOf": [{"const": {
        "identity": "OPTIMIZER_REFLECTION_GENERATION_POLICY_V1",
        "model": "qwen3.7-flash",
        "roles": [
          "reflection",
          "pattern"
        ],
        "enable_thinking": true,
        "temperature": 0.0,
        "max_completion_tokens": 1800,
        "max_tokens": "NOT_SENT",
        "output_token_scope": "reasoning_plus_answer",
        "measurement_tolerance_tokens": 10,
        "accounting_output_ceiling": 1810,
        "truncation": "existing_operational_output_truncation"
      }}, {"const": {
        "identity": "OPTIMIZER_REFLECTION_GENERATION_POLICY_V2",
        "model": "qwen3.7-flash",
        "roles": ["reflection", "pattern"],
        "enable_thinking": false,
        "temperature": 0.0,
        "max_completion_tokens": 1800,
        "max_tokens": "NOT_SENT",
        "output_token_scope": "reasoning_plus_answer",
        "measurement_tolerance_tokens": 10,
        "accounting_output_ceiling": 1810,
        "truncation": "existing_operational_output_truncation"
      }}]
    },
    "optimizer_amendment_authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "experiment_id",
    "method_identity",
    "benchmark_id",
    "benchmark_protocol_id",
    "search_engine_identity",
    "aggregation_identity",
    "responsibility_identity",
    "transition_identity",
    "adaptive_gate_identity",
    "pattern_identity",
    "memory_identity",
    "global_stop_identity",
    "schema_version",
    "method_family",
    "source_sha",
    "dataset_manifest_identity",
    "split_identity",
    "preregistration_identity",
    "seed",
    "models",
    "concurrency",
    "provider_policy",
    "cache_policy",
    "access",
    "budget",
    "authorization",
    "lifecycle",
    "hash_closure"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "execution_binding"
        ],
        "properties": {
          "execution_binding": {
            "properties": {
              "identity": {
                "const": "MATH_EXECUTION_BINDING_V1_4"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "solver_output_interface_identity",
          "parser_identity"
        ],
        "properties": {
          "solver_output_interface_identity": {
            "const": "MATH_SOLVER_INTERFACE_V2"
          },
          "parser_identity": {
            "const": "MATH_PAYLOAD_PARSER_V2"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "execution_binding"
        ],
        "properties": {
          "execution_binding": {
            "properties": {
              "identity": {
                "enum": [
                  "MATH_EXECUTION_BINDING_V1_2",
                  "MATH_EXECUTION_BINDING_V1_3"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "solver_output_interface_identity",
          "parser_identity"
        ],
        "properties": {
          "solver_output_interface_identity": {
            "const": "MATH_SOLVER_INTERFACE_V2"
          },
          "parser_identity": {
            "const": "math_verify_no_fallback_v1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2"
          }
        }
      },
      "then": {
        "required": [
          "search_acceptance_identity",
          "evidence_identity",
          "feasibility_identity",
          "mechanism_config"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2"
          },
          "memory_identity": {
            "const": "structured_agent_memory_v1"
          }
        },
        "required": [
          "method_family",
          "memory_identity"
        ]
      },
      "then": {
        "properties": {
          "mechanism_config": {
            "required": [
              "memory"
            ],
            "properties": {
              "memory": {
                "type": "object",
                "required": [
                  "top_k_private",
                  "top_k_shared",
                  "max_context_chars",
                  "private_storage_limit",
                  "shared_storage_limit"
                ],
                "properties": {
                  "top_k_private": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "top_k_shared": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_context_chars": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "private_storage_limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "shared_storage_limit": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2"
          },
          "pattern_identity": {
            "const": "pattern_diagnostic_v1"
          }
        },
        "required": [
          "method_family",
          "pattern_identity"
        ]
      },
      "then": {
        "properties": {
          "mechanism_config": {
            "required": [
              "pattern_provider_binding"
            ],
            "properties": {
              "pattern_provider_binding": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2_1"
          },
          "memory_identity": {
            "const": "strategy_experience_memory_v2"
          }
        },
        "required": [
          "method_family",
          "memory_identity"
        ]
      },
      "then": {
        "properties": {
          "mechanism_config": {
            "required": [
              "memory"
            ],
            "properties": {
              "memory": {
                "type": "object",
                "required": [
                  "top_k_private",
                  "top_k_shared",
                  "max_context_chars",
                  "private_storage_limit",
                  "shared_storage_limit"
                ],
                "properties": {
                  "top_k_private": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "top_k_shared": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_context_chars": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "private_storage_limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "shared_storage_limit": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2_1"
          },
          "pattern_identity": {
            "const": "focused_pattern_diagnostic_v2"
          }
        },
        "required": [
          "method_family",
          "pattern_identity"
        ]
      },
      "then": {
        "properties": {
          "mechanism_config": {
            "required": [
              "pattern_provider_binding"
            ],
            "properties": {
              "pattern_provider_binding": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "method_family"
        ],
        "properties": {
          "method_family": {
            "const": "unified_team_prompt_search_v2_1"
          }
        }
      },
      "then": {
        "required": [
          "search_acceptance_identity",
          "evidence_identity",
          "feasibility_identity",
          "mechanism_config"
        ],
        "properties": {
          "method_identity": {
            "const": "unified_team_prompt_search_v2_1"
          },
          "search_engine_identity": {
            "const": "gepa_derived_team_candidate_exposure_v2"
          },
          "search_acceptance_identity": {
            "const": "local_survival_team_admission_decoupled_v1"
          },
          "evidence_identity": {
            "const": "single_mechanism_evidence_v2"
          },
          "feasibility_identity": {
            "const": "variable_evidence_feasibility_v1"
          },
          "transition_identity": {
            "const": "initial_competence_team_gain_v2"
          },
          "pattern_identity": {
            "enum": [
              "null_pattern_v1",
              "focused_pattern_diagnostic_v2"
            ]
          },
          "memory_identity": {
            "enum": [
              "null_memory_v1",
              "strategy_experience_memory_v2"
            ]
          },
          "models": {
            "properties": {
              "solver": {
                "const": "qwen3-8b"
              },
              "optimizer": {
                "const": "qwen3.7-flash"
              },
              "solver_thinking": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "execution_binding"
        ],
        "properties": {
          "execution_binding": {
            "properties": {
              "identity": {
                "enum": [
                  "MATH_V2_1_EXECUTION_BINDING_V1",
                  "MATH_V2_1_EXECUTION_BINDING_V2",
                  "MATH_V2_1_EXECUTION_BINDING_V3",
                  "MATH_V2_1_LOW_COST_EXECUTION_BINDING_V1",
                  "MATH_V2_1_LOW_COST_EXECUTION_BINDING_V2"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "initial_competence_binding",
          "solver_output_interface_identity",
          "parser_identity"
        ],
        "properties": {
          "method_identity": {
            "const": "unified_team_prompt_search_v2_1"
          },
