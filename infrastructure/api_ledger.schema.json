{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["experiment_id", "run_id", "phase", "role", "call_index", "provider_call", "input_tokens", "output_tokens", "total_tokens", "retry_index", "success", "failure_category"],
  "properties": {
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "phase": {"type": "string"},
    "role": {"enum": ["Teacher", "Critic", "Student", "Solver", "Validation", "Test"]},
    "call_index": {"type": "integer", "minimum": 0},
    "provider_call": {"type": "boolean"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "retry_index": {"type": "integer", "minimum": 0},
    "success": {"type": "boolean"},
    "failure_category": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
