{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unified_backend_run.schema.json",
  "title": "Unified Layer1/Layer2 Run Record",
  "type": "object",
  "required": [
    "code_sha",
    "config_hash",
    "backend",
    "optimization_mode",
    "backend_fidelity",
    "initial_state",
    "optimization_opportunities",
    "candidate_funnel",
    "team_evaluation_funnel",
    "commits",
    "vote_trajectory",
    "oracle_trajectory",
    "member_accuracy_trajectory",
    "pivotality_trajectory",
    "categorical_profile_hashes",
    "cost_accounting",
    "final_state",
    "backend_details"
  ],
  "properties": {
    "code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"enum": ["gepa", "mars"]},
    "optimization_mode": {"enum": ["native", "layer2"]},
    "backend_fidelity": {"type": "string", "minLength": 1},
    "initial_state": {"type": "object"},
    "optimization_opportunities": {"type": "array"},
    "candidate_funnel": {"type": "object"},
    "team_evaluation_funnel": {"type": "object"},
    "commits": {"type": "array"},
    "vote_trajectory": {"type": "array"},
    "oracle_trajectory": {"type": "array"},
    "member_accuracy_trajectory": {"type": "array"},
    "pivotality_trajectory": {"type": "array"},
    "categorical_profile_hashes": {"type": "array", "items": {"type": "string"}},
    "cost_accounting": {"type": "object"},
    "final_state": {"type": "object"},
    "backend_details": {"type": "object"}
  },
  "additionalProperties": false
}
